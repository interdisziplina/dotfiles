#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Set vi mode because emacs is useless :)
set -o vi

export EDITOR="nvim"
export VISUAL="nvim"

alias ls='exa --icons always'
alias la='exa -a --icons always'
alias ll='exa --long -a --icons always'
alias tree='exa --tree'
alias fmt='cargo +nightly fmt'
alias cal='cal -m'
alias auth='sudo -v -p "authenticate: "'
alias watch='watch -n 1'

alias vim='nvim'
alias py='python'

alias cat='bat'
alias bathelp='bat --plain --language=help'
alias llm='uvx --with llm-gemini llm'

alias che='chezmoi'

alias grep='grep --color=auto'

alias share='live-server --host=192.162.2.117'

alias signal-cli='~/Sources/signal-cli-git/build/install/signal-cli/bin/signal-cli'
alias busgcc='gcc -std=c17 -Wall -Wextra -Wpedantic -fsanitize=address,undefined'

export HISTFILESIZE=
export HISTSIZE=
export HISTTIMEFORMAT="%F %T "
export HISTFILE=~/.bash_eternal_history
PROMPT_COMMAND="history -a; $PROMPT_COMMAND"

help() {
	"$@" --help 2>&1 | bathelp
}

alias h='help'

pacman() {
	echo "-" > /tmp/update-counter
	trap 'rm -f /tmp/update-counter' RETURN
	auth
	sudo pacman "$@"
}


pathprepend() {
	if ! grep -q "$1" <<<"$PATH"; then
		PATH="$1:$PATH"
	fi
}
pathappend() {
	if ! grep -q "$1" <<<"$PATH"; then
		PATH="$PATH:$1"
	fi
}

fixlock() {
	hyprctl --instance 0 'keyword misc:allow_session_lock_restore 1'
	sleep 0.5
	hyprctl --instance 0 'dispatch exec hyprlock'
	sleep 0.5
	logout
}

pathprepend "$HOME/.local/bin"
pathappend "$HOME/.cargo/bin"
pathprepend "$HOME/.config/rofi/scripts/"
pathappend "/opt/gurobi1103/linux64/bin"
pathappend "$HOME/.local/share/pnpm/bin"

export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/opt/gurobi1103/linux64/lib"

if [[ $TERM == "linux" ]]; then
  echo tty detected!
  return
fi

eval "$(zoxide init bash)"
eval "$(starship init bash)"

_not_inside_tmux() {
	[[ -z "$TMUX" ]]
}

ensure_tmux_is_running() {
  if _not_inside_tmux; then
    tat
  fi
}

ensure_tmux_is_running

export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
export GRIM_DEFAULT_DIR=~/Pictures/Screenshots
export GUROBI_HOME=/opt/gurobi1103/linux64
export GRB_LICENSE_FILE=~/.local/share/gurobi/gurobi.lic

. "$HOME/.atuin/bin/env"

[[ -f ~/.bash-preexec.sh ]] && source ~/.bash-preexec.sh
eval "$(atuin init bash --disable-up-arrow)"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# opencode
export PATH=/home/lina/.opencode/bin:$PATH
